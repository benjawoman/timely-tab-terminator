{
  "manifest_version": 2,
  "name": "Timely Tab Cleaner",
  "version": "1.1.0",
  "description": "TTT — close idle tabs automatically, with a whitelist, tab-count threshold, and tab group protection.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-cleaner@yourname",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": ["utils.js", "background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Timely Tab Cleaner (TTT)",
    "default_popup": "popup.html"
  }
}
