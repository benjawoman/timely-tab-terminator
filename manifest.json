{
  "manifest_version": 3,
  "name": "Timely Tab Terminator",
  "version": "2.0.0",
  "description": "Timely Tab Terminator — close idle tabs automatically, with a whitelist, tab-count threshold, and tab group protection.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-cleaner@yourname",
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": ["utils.js", "background.js"]
  },
  "action": {
    "default_title": "Timely Tab Terminator",
    "default_popup": "popup.html"
  }
}
